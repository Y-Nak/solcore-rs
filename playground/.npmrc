# Do not run package lifecycle scripts (preinstall/install/postinstall) on
# `npm install` / `npm ci`. Supply-chain hardening: no dependency gets to run
# arbitrary code at install time.
#
# Dependencies declaring install scripts include:
#   - fsevents: macOS-only optional file-watcher; skipping just falls back to
#     polling (and it is not installed on Linux at all).
#   - esbuild:  Vite's bundler. On 0.25.x the native binary ships as a
#     per-platform optional dependency (@esbuild/<platform>), so it normally
#     works without its postinstall. If Vite reports it cannot find the esbuild
#     binary, run the one trusted installer explicitly:
#       node node_modules/esbuild/install.js
#     (or provide esbuild from Nix in flake.nix and set ESBUILD_BINARY_PATH).
#   - workerd: Wrangler's local runtime also ships per-platform binaries as
#     optional dependencies. Its install script is not needed for deployment.
ignore-scripts=true
