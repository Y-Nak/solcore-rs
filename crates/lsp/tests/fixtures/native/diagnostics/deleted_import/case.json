{
  "documents": [
    "primary/main.sol",
    "primary/math.sol"
  ],
  "workspace_folders": [
    "primary"
  ],
  "steps": [
    {
      "kind": "open",
      "document": "primary/main.sol"
    },
    {
      "kind": "diagnostics",
      "document": "primary/main.sol",
      "contains": [
        {
          "severity": 1
        }
      ]
    },
    {
      "kind": "remove_file",
      "document": "primary/math.sol"
    },
    {
      "kind": "notify",
      "method": "workspace/didChangeWatchedFiles",
      "params": {
        "changes": [
          {
            "uri": "$uri:primary/math.sol",
            "type": 3
          }
        ]
      }
    },
    {
      "kind": "diagnostics",
      "document": "primary/main.sol",
      "contains": [
        {
          "severity": 1,
          "message_contains": "file not found"
        }
      ]
    }
  ]
}
